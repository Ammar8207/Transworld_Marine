---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import { site } from "../config.js";
import { ClientRouter } from "astro:transitions";
const { title = site.name, description = site.tagline, image = "/favicon.svg", type = "website" } = Astro.props;
const documentTitle = title.endsWith(site.name) ? title : `${title} | ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = new URL(image, Astro.url);
---
<html lang="en" transition:animate="fade">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1a2f" />
    <ClientRouter />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <slot name="head" />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${site.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <StickyMobileCTA />
    <script src="../scripts/reveal.js"></script>
    <script>
      function initScrollRestoration() {
        if (document.documentElement.dataset.scrollRestorationInitialized === "true") return;
        document.documentElement.dataset.scrollRestorationInitialized = "true";
        document.addEventListener("astro:after-swap", () => window.scrollTo(0, 0));
      }

      document.addEventListener("DOMContentLoaded", initScrollRestoration);
      document.addEventListener("astro:page-load", initScrollRestoration);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --dark-bg: #071827;
    --dark-surface: #0d2639;
    --dark-border: #1d3d52;
    --dark-overlay: rgb(7 24 39 / 28%);
    --dark-text: #f4f8f8;
    --light-bg: #f3f7f6;
    --light-surface: #ffffff;
    --light-text: #102a38;
    --light-muted: #5c707b;
    --light-border: #dbe7e5;
    --light-accent: #08786c;
    --accent: #22c1ad;
    --accent-hover: #47d7c3;
    --accent-soft: #d9f3ee;
    --shadow: 0 1.25rem 3rem rgb(16 42 56 / 9%);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --dur-fast: 250ms;
    --dur: 500ms;
    --dur-slow: 700ms;
    --bg: var(--light-bg);
    --surface: var(--light-surface);
    --text: var(--light-text);
    --muted: var(--light-muted);
    --border: var(--light-border);
  }

  html { max-width: 100%; overflow-x: clip; scroll-behavior: smooth; }
  body {
    max-width: 100%;
    margin: 0;
    overflow-x: clip;
    background: var(--light-bg);
    color: var(--light-text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  main { width: 100%; }
  @media (max-width: 767px) { main { padding-bottom: 80px; } }
  *, *::before, *::after { box-sizing: border-box; }
  .skip-link { position: absolute; top: 0; left: -9999px; z-index: 200; padding: 0.75rem 1rem; background: var(--accent); color: var(--dark-bg); font-weight: 700; text-decoration: none; }
  .skip-link:focus { position: fixed; top: 12px; left: 12px; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 3rem; padding: 0.8rem 1.35rem; border: 1px solid transparent; border-radius: 0.5rem; font-weight: 700; text-decoration: none; cursor: pointer; transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  .btn-primary, .btn-primary:link, .btn-primary:visited, .btn-primary:hover, .btn-primary:focus, .btn-primary:active { background: var(--accent); color: #0b0f14; }
  .btn-primary:hover, .btn-primary:focus-visible { background-color: var(--accent-hover); transform: translateY(-2px); box-shadow: 0 0.75rem 1.5rem rgb(34 193 173 / 22%); }
  .btn-primary:active { transform: translateY(0) scale(0.98); }
  .btn-secondary { background: transparent; border: 1.5px solid var(--accent); color: var(--accent); }
  .btn-secondary:hover, .btn-secondary:focus-visible { background-color: color-mix(in srgb, var(--accent) 10%, transparent); border-color: var(--accent); color: var(--accent); }
  .btn-primary:focus-visible, .btn-secondary:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  a > span[aria-hidden="true"] { display: inline-block; transition: transform var(--dur-fast) var(--ease); }
  a:hover > span[aria-hidden="true"], a:focus-visible > span[aria-hidden="true"] { transform: translateX(4px); }
  .submit-button { transition: transform var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  .submit-button:hover { transform: translateY(-2px); box-shadow: 0 0.75rem 1.5rem rgb(34 193 173 / 22%); }
  .submit-button:active { transform: translateY(0) scale(0.98); }
  html.reveal-ready [data-reveal] { opacity: 0; transform: translateY(1.25rem); transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease); transition-delay: var(--reveal-delay, 0ms); }
  html.reveal-ready [data-reveal].is-revealed, html.reveal-ready [data-reveal].reveal-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0s !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0s !important; transform: none !important; }
    html.reveal-ready [data-reveal] { opacity: 1; transform: none; }
  }
</style>