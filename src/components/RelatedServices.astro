---
import { services } from "../data/services.js";

interface Props {
  current: string;
}

const { current } = Astro.props;
const relatedServices = services.filter((service) => service.slug !== current);
---

<section class="related-services" aria-labelledby="related-services-title">
  <p class="eyebrow">Also from Harborline</p>
  <h2 id="related-services-title">Explore our other services.</h2>
  <div class="related-grid">
    {relatedServices.map((service) => (
      <article class="related-card">
        <img src={service.image} alt={service.imageAlt} width="640" height="360" loading="lazy" />
        <div class="related-card-content">
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
          <a href={`/services/${service.slug}`}>Explore <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .related-services { margin-top: clamp(4rem, 8vw, 7rem); padding: clamp(2rem, 5vw, 3.5rem); border: 1px solid var(--dark-border); border-radius: 1rem; background: var(--dark-surface); color: var(--dark-text); }
  .eyebrow { margin: 0 0 0.75rem; color: var(--accent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.25rem); letter-spacing: -0.05em; }
  .related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .related-card { display: grid; grid-template-columns: minmax(120px, 0.8fr) minmax(0, 1.2fr); overflow: hidden; border: 1px solid var(--dark-border); border-radius: 0.75rem; background: color-mix(in srgb, var(--dark-bg) 55%, var(--dark-surface)); transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease); }
  .related-card:hover { transform: translateY(-3px); border-color: var(--accent); }
  .related-card img { width: 100%; height: 100%; min-height: 180px; object-fit: cover; }
  .related-card-content { display: flex; flex-direction: column; padding: 1.25rem; }
  h3 { margin: 0; font-size: 1.35rem; }
  .related-card p { margin: 0.7rem 0 1.25rem; color: var(--dark-text); opacity: 0.72; font-size: 0.9rem; line-height: 1.5; }
  .related-card a { margin-top: auto; color: var(--accent); font-weight: 700; text-underline-offset: 0.25rem; }
  .related-card a span { display: inline-block; transition: transform var(--dur-fast) var(--ease); }
  .related-card a:hover span, .related-card a:focus-visible span { transform: translateX(4px); }
  @media (max-width: 700px) { .related-grid { grid-template-columns: 1fr; } }
</style>
