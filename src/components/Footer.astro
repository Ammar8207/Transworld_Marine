---
import { site } from "../config.js";
import { services } from "../data/services.js";
---
<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="logo" href="/">{site.name}</a>
      <p>Dependable provisions, stores, and marine logistics for vessels wherever they call.</p>
    </div>
    <div>
      <h2>Services</h2>
      <nav aria-label="Footer services">
        {services.map((service) => <a href={`/services/${service.slug}`}>{service.title}</a>)}
      </nav>
    </div>
    <div>
      <h2>Company</h2>
      <nav aria-label="Footer company links">
        <a href="/about">About</a>
        <a href="/ports">Ports</a>
        <a href="/faq">FAQ</a>
        <a href="/news">News</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
    <div>
      <h2>Contact</h2>
      <address>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`tel:${site.phone.replace(/[^+\d]/g, "")}`}>{site.phone}</a>
        <span>{site.address}</span>
      </address>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
    <a href="#top">Back to top</a>
  </div>
</footer>

<style>
  footer { padding: clamp(4rem, 7vw, 6rem) max(1.25rem, calc((100% - 1200px) / 2)) 1.5rem; background: var(--dark-bg); color: var(--dark-text); border-top: 1px solid var(--dark-border); }
  .footer-grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: clamp(2rem, 5vw, 5rem); }
  .logo { color: var(--dark-text); font-size: 1.4rem; font-weight: 700; text-decoration: none; }
  .footer-brand p { max-width: 250px; margin: 1.25rem 0 0; color: var(--dark-text); opacity: 0.75; line-height: 1.6; }
  h2 { margin: 0 0 1.25rem; color: var(--dark-text); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; }
  nav, address { display: flex; flex-direction: column; gap: 0.75rem; font-style: normal; }
  footer a, address span { color: var(--dark-text); text-decoration-color: var(--accent); text-underline-offset: 0.25rem; }
  footer a:hover { color: var(--accent-hover); }
  address span { opacity: 0.75; line-height: 1.5; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--dark-border); color: var(--dark-text); opacity: 0.75; font-size: 0.85rem; }
  @media (max-width: 700px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } .footer-brand { grid-column: auto; } .footer-bottom { align-items: flex-start; flex-direction: column; } }
</style>