---
import { ports } from "../data/ports.js";

const featuredPorts = ports.slice(0, 8);
---

<section class="ports-preview" aria-labelledby="ports-preview-title">
  <svg class="world-map" viewBox="0 0 1200 600" aria-hidden="true" focusable="false">
    <path d="M105 164 132 125l58-20 38 15 32-13 53 22 18 35-28 22-35-7-16 22-42-7-19 28-46-8-21-30-28-20 9-20Zm176 91 29 10 22 35-11 40-24 32-20-7 5-35-22-20 21-27Zm114-5 44 10 20 29-17 29-37-3-18-23 8-28Zm82-104 42-20 42 6 33-16 71 12 34 23 64 2 44 22 55-6 66 22 45 34-20 27-51-4-27 20-48-13-36 16-43-13-51 17-39-25-41 6-26-21-43 4-34-24-31-10-28-39Zm-10 90 29 6 13 23-23 20-33-8-9-20 23-21Zm-94 35 38 15 24 37-4 52-27 45-26 57-33-13-14-54 12-52-17-36 17-51Zm430 35 38-16 39 14 19 30-20 28-44 1-35-22 3-35Zm94 12 44-7 34 21 3 25-30 16-38-12-26-21 13-22Zm-7 85 40 14 25 27-10 28-37 5-29-26 11-48Zm-182 23 34-10 29 20-8 28-35 8-24-20 4-26Zm-47 36 26-1 23 20-12 33-30-1-15-25 8-26Z" />
  </svg>
  <div class="ports-preview-inner">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Where we operate</p>
      <h2 id="ports-preview-title">Present in 120+ ports worldwide</h2>
    </div>
    <section class="port-list" aria-label="Featured ports">
      {featuredPorts.map((port, index) => (
        <span class="port-pill" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <strong>{port.name}</strong>
          <span>{port.country}</span>
        </span>
      ))}
    </section>
    <a class="ports-link" href="/ports">View all ports <span aria-hidden="true">-&gt;</span></a>
  </div>
</section>

<style>
  .ports-preview { position: relative; overflow: hidden; padding: clamp(5rem, 9vw, 8rem) clamp(1.25rem, 5vw, 3rem); background: var(--dark-bg); color: var(--dark-text); }
  .ports-preview-inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; }
  .world-map { position: absolute; top: 50%; left: 50%; width: min(1400px, 110%); height: auto; transform: translate(-50%, -50%); color: var(--accent); opacity: 0.06; }
  .world-map path { fill: currentColor; }
  .section-heading { max-width: 720px; }
  .eyebrow { margin: 0 0 1rem; color: var(--accent); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  h2 { max-width: 12ch; margin: 0; font-size: clamp(2.3rem, 5vw, 4.5rem); line-height: 1.02; letter-spacing: -0.035em; }
  .port-list { display: flex; flex-wrap: wrap; gap: 0.75rem; max-width: 980px; margin-top: 3rem; }
  .port-pill { display: inline-flex; flex-wrap: wrap; gap: 0.45rem; align-items: baseline; padding: 0.65rem 0.9rem; border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--dark-surface) 72%, transparent); }
  .port-pill strong { color: var(--accent); font-size: 0.95rem; }
  .port-pill span { color: var(--dark-text); opacity: 0.72; font-size: 0.82rem; }
  .ports-link { display: inline-flex; gap: 0.45rem; align-items: center; margin-top: 2.5rem; color: var(--accent); font-weight: 700; text-decoration-color: color-mix(in srgb, var(--accent) 65%, transparent); text-underline-offset: 0.35rem; }
  .ports-link:hover { color: var(--accent-hover); }
  @media (max-width: 600px) { .port-pill { width: 100%; justify-content: space-between; } }
</style>
